# Non-secret LAN configuration. Copy outside the repository for deployment.
REMOTELINK_TARGETS_FILE=/etc/remotelink/targets.json
REMOTELINK_TARGET_SERVER_55_PASSWORD=change-me
REMOTELINK_ALLOWED_HOSTS=*
REMOTELINK_TLS_CERTIFICATE=/etc/remotelink/tls/fullchain.pem
REMOTELINK_TLS_PRIVATE_KEY=/etc/remotelink/tls/privkey.pem
# Instead of the two TLS paths, use REMOTELINK_BEHIND_TLS_PROXY=1 only when a trusted
# reverse proxy provides HTTPS/WSS and forwards to this service over HTTP.
# Optional comma-separated additional user access tokens. The primary
# REMOTELINK_ACCESS_TOKEN/REMOTELINK_ACCESS_TOKEN_FILE remains valid for compatibility.
REMOTELINK_ACCESS_TOKENS=
REMOTELINK_STATE_DIR=/var/lib/remotelink
REMOTELINK_USER_FILE_QUOTA_BYTES=5368709120
# Optional comma-separated lowercase extensions, for example: .exe,.js,.sh
REMOTELINK_BLOCKED_FILE_EXTENSIONS=
