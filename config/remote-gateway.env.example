# Non-secret LAN configuration. Copy outside the repository for deployment.
RG_TARGETS_FILE=/etc/remote-gateway/targets.json
RG_TARGET_SERVER_55_PASSWORD=change-me
RG_ALLOWED_HOSTS=*
RG_TLS_CERTIFICATE=/etc/remote-gateway/tls/fullchain.pem
RG_TLS_PRIVATE_KEY=/etc/remote-gateway/tls/privkey.pem
# Instead of the two TLS paths, use RG_BEHIND_TLS_PROXY=1 only when a trusted
# reverse proxy provides HTTPS/WSS and forwards to this service over HTTP.
# Optional comma-separated additional user access tokens. The primary
# RG_ACCESS_TOKEN/RG_ACCESS_TOKEN_FILE remains valid for compatibility.
RG_ACCESS_TOKENS=
RG_STATE_DIR=/var/lib/remote-gateway
RG_USER_FILE_QUOTA_BYTES=5368709120
# Optional comma-separated lowercase extensions, for example: .exe,.js,.sh
RG_BLOCKED_FILE_EXTENSIONS=
