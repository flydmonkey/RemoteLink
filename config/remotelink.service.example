[Unit]
Description=RemoteLink LAN service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remotelink
Group=remotelink
WorkingDirectory=/opt/remotelink
ExecStart=/opt/remotelink/build/remotelink
Restart=on-failure
RestartSec=2
UMask=0077
StateDirectory=remotelink
StateDirectoryMode=0750
Environment=REMOTELINK_ACCESS_TOKEN_FILE=%d/access-token
Environment=REMOTELINK_STATE_DIR=/var/lib/remotelink
Environment=REMOTELINK_TARGETS_FILE=/etc/remotelink/targets.json
Environment=REMOTELINK_ALLOWED_HOSTS=*
Environment=REMOTELINK_TLS_CERTIFICATE=/etc/remotelink/tls/fullchain.pem
Environment=REMOTELINK_TLS_PRIVATE_KEY=/etc/remotelink/tls/privkey.pem
LoadCredentialEncrypted=access-token:/etc/credstore.encrypted/remotelink-access-token
LoadCredentialEncrypted=server-55-password:/etc/credstore.encrypted/remotelink-server-55-password
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
LockPersonality=true

[Install]
WantedBy=multi-user.target
